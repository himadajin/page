---
import IconX from "@/assets/icons/IconX.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import { SECTIONS, SITE } from "@/config";
import type { OutlineSection } from "@/utils/outline";

type Props = {
  outlineTitle?: string;
  outlineSections?: OutlineSection[];
};

const { outlineTitle, outlineSections = [] } = Astro.props;
const hasOutline = outlineSections.length >= 2;
const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navLinks = [
  ...SECTIONS.map(section => ({
    label: section.label,
    path: section.path,
    active: isActive(section.path),
  })),
  { label: "Tags", path: "/tags", active: isActive("/tags") },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-[60] bg-background px-3 py-2 text-accent transition-all focus:top-16"
>
  Skip to content
</a>

<header
  id="site-header"
  class="glass-panel sticky top-0 z-50 border-b border-transparent transition-[border-color] duration-200 data-scrolled:border-border"
>
  <div class="app-layout flex h-(--header-h) items-center justify-between gap-2">
    <a href="/" class="text-base font-semibold tracking-tight whitespace-nowrap">
      {SITE.title}
    </a>
    <nav
      id="nav-menu"
      class="flex items-center gap-0.5 sm:gap-1"
      aria-label="Site"
    >
      {
        navLinks.map(link => (
          <a
            href={link.path}
            class:list={[
              "px-2 py-1.5 text-[0.8125rem] leading-none underline-offset-4 transition-colors duration-150",
              link.active
                ? "active-nav text-foreground"
                : "text-foreground/70 decoration-foreground/35 decoration-dashed hover:text-foreground hover:underline",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/search"
        class:list={[
          "grid size-8 place-items-center text-foreground/70 transition-colors duration-150 hover:text-foreground",
          { "text-foreground": isActive("/search") },
        ]}
        title="Search"
      >
        <IconSearch class="size-4" />
        <span class="sr-only">Search</span>
      </a>
      {
        hasOutline && (
          <button
            id="menu-btn"
            class="grid size-8 place-items-center text-foreground/70 transition-colors duration-150 hover:text-foreground min-[1180px]:hidden"
            aria-label="Open sections"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <IconX id="close-icon" class="hidden size-4" />
            <IconMenuDeep id="menu-icon" class="size-4" />
          </button>
        )
      }
    </nav>
  </div>
</header>

{
  hasOutline && (
    <div
      id="mobile-menu"
      class="site-menu-panel fixed top-(--header-h) z-40 max-h-[calc(100svh-4.5rem)] overflow-y-auto px-4 py-4"
      hidden
    >
      <div class="mobile-menu__sections" data-menu-outline>
        <p class="mobile-menu__title">{outlineTitle}</p>
        <p class="mobile-menu__label">Sections</p>
        <nav aria-label="Page sections">
          <a class="mobile-menu__top" href="#main-content">
            Top
          </a>
          <ol class="mobile-menu__section-list">
            {outlineSections.map(section => (
              <li
                class="mobile-menu__section-item"
                data-menu-section={section.id}
              >
                <a class="mobile-menu__section-link" href={`#${section.id}`}>
                  {section.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  )
}

<style>
  .site-menu-panel {
    inset-inline-start: auto;
    inset-inline-end: 0;
    box-sizing: border-box;
    width: min(calc(100vw - 1rem), 24rem);
    border-inline-start: 1px solid var(--border);
    border-block-end: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  @media (min-width: 1180px) {
    .site-menu-panel {
      display: none;
    }
  }

  .mobile-menu__title {
    margin: 0 0 0.75rem;
    overflow: hidden;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mobile-menu__label {
    margin: 0 0 0.5rem;
    color: color-mix(in srgb, var(--foreground) 46%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .mobile-menu__top,
  .mobile-menu__section-link {
    display: block;
    text-decoration: none;
  }

  .mobile-menu__top {
    margin-inline-start: 0.75rem;
    padding: 0.375rem 0.625rem;
    color: color-mix(in srgb, var(--foreground) 58%, transparent);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .mobile-menu__section-list {
    margin: 0.25rem 0 0;
    padding: 0;
    border-inline-start: 1px solid var(--border);
    list-style: none;
  }

  .mobile-menu__section-item {
    position: relative;
  }

  .mobile-menu__section-item::before {
    position: absolute;
    inset-block: 0.45rem;
    inset-inline-start: -1px;
    width: 1px;
    background: transparent;
    content: "";
  }

  .mobile-menu__section-link {
    padding: 0.4375rem 0.625rem 0.4375rem 0.75rem;
    color: color-mix(in srgb, var(--foreground) 58%, transparent);
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .mobile-menu__section-item.is-active::before {
    background: var(--accent);
  }

  .mobile-menu__section-item.is-active > .mobile-menu__section-link {
    color: var(--foreground);
    font-weight: 600;
  }

  .mobile-menu__top:hover,
  .mobile-menu__section-link:hover {
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-style: dashed;
    text-decoration-color: color-mix(in srgb, var(--foreground) 35%, transparent);
    text-underline-offset: 4px;
  }
</style>

<script>
  function setupNav() {
    const navWindow = window as Window & {
      __headerNavAbortController?: AbortController;
    };

    navWindow.__headerNavAbortController?.abort();

    const controller = new AbortController();
    navWindow.__headerNavAbortController = controller;
    const { signal } = controller;

    const header = document.getElementById("site-header");
    if (header) {
      const updateScrolled = () => {
        header.toggleAttribute("data-scrolled", window.scrollY > 8);
      };
      document.addEventListener("scroll", updateScrolled, {
        passive: true,
        signal,
      });
      updateScrolled();
    }

    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
    const menuIcon = document.querySelector<SVGElement>("#menu-icon");
    const closeIcon = document.querySelector<SVGElement>("#close-icon");

    if (!menuBtn || !mobileMenu || !menuIcon || !closeIcon) return;

    const navButton = menuBtn;
    const menuPanel = mobileMenu;
    const openIcon = menuIcon;
    const shutIcon = closeIcon;

    const sectionItems = Array.from(
      menuPanel.querySelectorAll("[data-menu-section]")
    );
    const sectionHeadings = sectionItems
      .map(item => {
        const id = item.getAttribute("data-menu-section");
        const heading = id ? document.getElementById(id) : null;
        return heading ? { id, heading } : null;
      })
      .filter(
        (item): item is { id: string; heading: HTMLElement } => item !== null
      );

    let activeId = "";
    let ticking = false;

    function setMenuOpen(open: boolean) {
      navButton.setAttribute("aria-expanded", open ? "true" : "false");
      navButton.setAttribute(
        "aria-label",
        open ? "Close sections" : "Open sections"
      );
      menuPanel.hidden = !open;
      openIcon.classList.toggle("hidden", open);
      shutIcon.classList.toggle("hidden", !open);

      if (open) {
        updateActiveSection();
      }
    }

    function setActive(id: string) {
      if (!id || activeId === id) return;
      activeId = id;

      for (const item of sectionItems) {
        const isActive = item.getAttribute("data-menu-section") === id;
        item.classList.toggle("is-active", isActive);

        const link = item.querySelector(".mobile-menu__section-link");
        if (link) {
          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      }
    }

    function updateActiveSection() {
      ticking = false;
      const offset = 140;
      let nextActiveId = sectionHeadings[0]?.id || "";

      for (const item of sectionHeadings) {
        const top = item.heading.getBoundingClientRect().top;
        if (top <= offset) {
          nextActiveId = item.id;
        } else {
          break;
        }
      }

      setActive(nextActiveId);
    }

    function requestUpdate() {
      if (ticking || sectionHeadings.length === 0) return;
      ticking = true;
      window.requestAnimationFrame(updateActiveSection);
    }

    navButton.addEventListener(
      "click",
      () => {
        const isOpen = navButton.getAttribute("aria-expanded") === "true";
        setMenuOpen(!isOpen);
      },
      { signal }
    );

    menuPanel.addEventListener(
      "click",
      event => {
        const target = event.target;
        if (target instanceof Element && target.closest("a[href]")) {
          setMenuOpen(false);
        }
      },
      { signal }
    );

    document.addEventListener("scroll", requestUpdate, {
      passive: true,
      signal,
    });
    window.addEventListener("resize", requestUpdate, { signal });

    updateActiveSection();
  }

  setupNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", setupNav);
</script>
