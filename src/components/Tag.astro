---
type Props = {
  tag: string;
  tagName: string;
};

const { tag, tagName } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "inline-block meta-label text-foreground/65",
      "border-b border-dashed border-foreground/35",
      "hover:border-accent hover:text-accent",
      "focus-visible:border-none focus-visible:text-accent",
    ]}
  >
    <span aria-hidden="true" class="opacity-60">#</span>{tagName}
  </a>
</li>
