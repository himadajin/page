---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import PromptCopyButton from "@/components/PromptCopyButton.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CodeBlockCopy from "@/components/CodeBlockCopy.astro";
import HeadingLinks from "@/components/HeadingLinks.astro";
import ReadingMap from "@/components/ReadingMap.astro";
import type { ReferenceItem } from "@/utils/references";
import { getOutlineSections, shouldShowOutline } from "@/utils/outline";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

type Props = ReferenceItem & {
  translationEntry: CollectionEntry<"promptTranslations">;
};

const { entry, href, translationEntry } = Astro.props;

const { title, description, ogImage: initOgImage, tags } = entry.data;

const { Content, headings } = await render(entry);
const hasTranslation = Boolean((translationEntry.body ?? "").trim());
const translation = hasTranslation ? await render(translationEntry) : undefined;
const TranslationContent = translation?.Content;
const outlineSections = getOutlineSections(headings);
const hasOutline = shouldShowOutline(outlineSections);

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${href}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  description,
  ogImage,
};

const promptCopySourceId = `prompt-copy-source-${entry.id.replaceAll("/", "-")}`;
const promptVariantGroupId = `prompt-variant-${entry.id.replaceAll("/", "-")}`;
---

<Layout {...layoutProps}>
  <Header
    outlineTitle={hasOutline ? title : undefined}
    outlineSections={hasOutline ? outlineSections : []}
  />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12" data-pagefind-body>
    <h1
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="inline-block text-3xl font-medium tracking-tight text-accent sm:text-4xl"
    >
      {title}
    </h1>
    <div class="my-2 flex flex-wrap items-center gap-x-2 gap-y-1">
      <PromptCopyButton
        text={entry.body ?? ""}
        sourceId={promptCopySourceId}
        label="Copy original prompt"
      />
    </div>
    {
      TranslationContent && (
        <div
          class="sticky top-2 z-10 mt-8 flex w-full max-w-app border-y border-border bg-background/90 py-2 text-sm backdrop-blur-sm"
          role="group"
          aria-label="Prompt language"
          data-prompt-variant-group={promptVariantGroupId}
        >
          <button
            type="button"
            class="relative px-0 py-1 meta-label text-foreground transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:bg-accent after:opacity-0 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:after:opacity-100"
            aria-pressed="true"
            data-prompt-variant-trigger="original"
          >
            Original
          </button>
          <span class="px-2 py-1 text-foreground/35" aria-hidden="true">
            /
          </span>
          <button
            type="button"
            class="relative px-0 py-1 meta-label text-foreground transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:bg-accent after:opacity-0 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:after:opacity-100"
            aria-pressed="false"
            data-prompt-variant-trigger="translation"
          >
            Japanese
          </button>
        </div>
      )
    }
    <article
      id="article"
      class:list={[
        "app-prose w-full max-w-app",
        TranslationContent ? "mt-6" : "mt-8",
      ]}
      data-prompt-current={promptVariantGroupId}
      data-prompt-active-variant="original"
    >
      <Content />
    </article>
    {
      TranslationContent && (
        <>
          <template
            data-prompt-template={promptVariantGroupId}
            data-prompt-variant="original"
          />
          <template
            data-prompt-template={promptVariantGroupId}
            data-prompt-variant="translation"
          >
            <TranslationContent />
          </template>
        </>
      )
    }

    <hr class="my-8" />

    {
      tags.length > 0 && (
        <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
          {tags.map(tag => (
            <Tag tag={slugifyStr(tag)} tagName={tag} />
          ))}
        </ul>
      )
    }
  </main>
  <ReadingMap title={title} sections={hasOutline ? outlineSections : []} />
  <CodeBlockCopy />
  <HeadingLinks />
  <Footer />
</Layout>

<script>
  document.querySelectorAll("[data-prompt-variant-group]").forEach(group => {
    const groupId = group.getAttribute("data-prompt-variant-group");
    if (!groupId) return;

    const triggers = group.querySelectorAll("[data-prompt-variant-trigger]");
    const headingSelector = "h1, h2, h3, h4, h5, h6";

    function getActiveArticle() {
      return document.querySelector<HTMLElement>(
        `[data-prompt-current="${groupId}"]`
      );
    }

    function getTemplate(variant: string) {
      return document.querySelector<HTMLTemplateElement>(
        `template[data-prompt-template="${groupId}"][data-prompt-variant="${variant}"]`
      );
    }

    function getArticleHeadings(article: Element) {
      return Array.from(article.querySelectorAll<HTMLElement>(headingSelector));
    }

    function getVisibleTop() {
      return window.scrollY + Math.round(window.innerHeight * 0.22);
    }

    function runAfterNextPaint(callback: () => void) {
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(callback);
      });
    }

    function getArticleProgress(article: HTMLElement) {
      const top = article.getBoundingClientRect().top + window.scrollY;
      const height = Math.max(article.scrollHeight - window.innerHeight, 1);
      return Math.min(Math.max((window.scrollY - top) / height, 0), 1);
    }

    function getScrollAnchor(article: HTMLElement) {
      const visibleTop = getVisibleTop();
      const articleTop = article.getBoundingClientRect().top + window.scrollY;

      if (window.scrollY < articleTop) {
        return {
          headingId: "",
          headingIndex: -1,
          offset: 0,
          progress: 0,
          pageScrollY: window.scrollY,
        };
      }

      const headings = getArticleHeadings(article);
      let headingIndex = -1;
      let headingTop = 0;

      headings.forEach((heading, index) => {
        const top = heading.getBoundingClientRect().top + window.scrollY;
        if (top <= visibleTop) {
          headingIndex = index;
          headingTop = top;
        }
      });

      if (headingIndex >= 0) {
        return {
          headingId: headings[headingIndex]?.id ?? "",
          headingIndex,
          offset: visibleTop - headingTop,
          progress: getArticleProgress(article),
          pageScrollY: null,
        };
      }

      return {
        headingId: "",
        headingIndex,
        offset: visibleTop - articleTop,
        progress: getArticleProgress(article),
        pageScrollY: null,
      };
    }

    function restoreScrollAnchor(
      article: HTMLElement,
      anchor: ReturnType<typeof getScrollAnchor>
    ) {
      if (anchor.pageScrollY !== null) {
        window.scrollTo({ top: anchor.pageScrollY, behavior: "auto" });
        return;
      }

      const headings = getArticleHeadings(article);
      const targetHeading =
        headings.find(heading => heading.id === anchor.headingId) ??
        headings[anchor.headingIndex];

      if (targetHeading) {
        const targetTop =
          targetHeading.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({
          top: Math.max(
            0,
            targetTop + anchor.offset - Math.round(window.innerHeight * 0.22)
          ),
          behavior: "auto",
        });
        return;
      }

      const articleTop = article.getBoundingClientRect().top + window.scrollY;
      const targetTop =
        articleTop +
        Math.max(article.scrollHeight - window.innerHeight, 1) *
          anchor.progress;
      window.scrollTo({ top: Math.max(0, targetTop), behavior: "auto" });
    }

    triggers.forEach(trigger => {
      trigger.addEventListener("click", () => {
        const variant = trigger.getAttribute("data-prompt-variant-trigger");
        if (!variant) return;
        if (trigger.getAttribute("aria-pressed") === "true") return;

        const article = getActiveArticle();
        const targetTemplate = getTemplate(variant);
        if (!article || !targetTemplate) return;

        const activeVariant = article.dataset.promptActiveVariant;
        if (!activeVariant) return;
        if (activeVariant === variant) return;

        const activeTemplate = getTemplate(activeVariant);
        if (!activeTemplate) return;

        triggers.forEach(item => {
          item.setAttribute("aria-pressed", String(item === trigger));
        });

        runAfterNextPaint(() => {
          const anchor = getScrollAnchor(article);
          const activeContent = Array.from(article.childNodes);
          const targetContent = Array.from(targetTemplate.content.childNodes);

          document.documentElement.style.overflowAnchor = "none";
          activeTemplate.content.replaceChildren(...activeContent);
          article.replaceChildren(...targetContent);
          article.dataset.promptActiveVariant = variant;
          document.dispatchEvent(new CustomEvent("prompt:content-ready"));

          restoreScrollAnchor(article, anchor);
          window.requestAnimationFrame(() => {
            restoreScrollAnchor(article, anchor);
            window.requestAnimationFrame(() => {
              document.documentElement.style.overflowAnchor = "";
            });
          });
        });
      });
    });
  });
</script>
