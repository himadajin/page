---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import PromptCopyButton from "@/components/PromptCopyButton.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CodeBlockCopy from "@/components/CodeBlockCopy.astro";
import HeadingLinks from "@/components/HeadingLinks.astro";
import ReadingMap from "@/components/ReadingMap.astro";
import type { ReferenceItem } from "@/utils/references";
import { getOutlineSections, shouldShowOutline } from "@/utils/outline";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

type Props = ReferenceItem & {
  translationEntry: CollectionEntry<"promptTranslations">;
};

const { entry, href, translationEntry } = Astro.props;

const { title, description, ogImage: initOgImage, tags } = entry.data;

const { Content, headings } = await render(entry);
const hasTranslation = Boolean((translationEntry.body ?? "").trim());
const translation = hasTranslation ? await render(translationEntry) : undefined;
const TranslationContent = translation?.Content;
const outlineSections = getOutlineSections(headings);
const hasOutline = shouldShowOutline(outlineSections);

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${href}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  description,
  ogImage,
};

const promptCopySourceId = `prompt-copy-source-${entry.id.replaceAll("/", "-")}`;
const promptVariantGroupId = `prompt-variant-${entry.id.replaceAll("/", "-")}`;
---

<Layout {...layoutProps}>
  <Header
    outlineTitle={hasOutline ? title : undefined}
    outlineSections={hasOutline ? outlineSections : []}
  />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12" data-pagefind-body>
    <h1
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <div class="my-2 flex flex-wrap items-center gap-x-2 gap-y-1">
      <PromptCopyButton
        text={entry.body ?? ""}
        sourceId={promptCopySourceId}
        label="Copy original prompt"
      />
      {
        TranslationContent && (
          <div
            class="inline-flex rounded-md border border-border bg-background p-0.5 text-sm"
            role="group"
            aria-label="Prompt language"
            data-prompt-variant-group={promptVariantGroupId}
          >
            <button
              type="button"
              class="rounded-sm px-3 py-1.5 font-medium text-foreground transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent focus-visible:outline-dashed aria-pressed:bg-accent aria-pressed:text-background"
              aria-pressed="true"
              data-prompt-variant-trigger="original"
            >
              Original
            </button>
            <button
              type="button"
              class="rounded-sm px-3 py-1.5 font-medium text-foreground transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent focus-visible:outline-dashed aria-pressed:bg-accent aria-pressed:text-background"
              aria-pressed="false"
              data-prompt-variant-trigger="translation"
            >
              Japanese
            </button>
          </div>
        )
      }
    </div>
    <article
      id="article"
      class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg)"
      data-prompt-variant-panel={promptVariantGroupId}
      data-prompt-variant="original"
    >
      <Content />
    </article>
    {
      TranslationContent && (
        <article
          id="article-translation"
          class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg)"
          data-prompt-variant-panel={promptVariantGroupId}
          data-prompt-variant="translation"
          hidden
        >
          <TranslationContent />
        </article>
      )
    }

    <hr class="my-8 border-dashed" />

    {
      tags.length > 0 && (
        <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
          {tags.map(tag => (
            <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
          ))}
        </ul>
      )
    }
  </main>
  <ReadingMap title={title} sections={hasOutline ? outlineSections : []} />
  <CodeBlockCopy />
  <HeadingLinks />
  <Footer />
</Layout>

<script>
  document.querySelectorAll("[data-prompt-variant-group]").forEach(group => {
    const groupId = group.getAttribute("data-prompt-variant-group");
    if (!groupId) return;

    const triggers = group.querySelectorAll("[data-prompt-variant-trigger]");
    const panels = document.querySelectorAll(
      `[data-prompt-variant-panel="${groupId}"]`
    );

    triggers.forEach(trigger => {
      trigger.addEventListener("click", () => {
        const variant = trigger.getAttribute("data-prompt-variant-trigger");
        if (!variant) return;

        triggers.forEach(item => {
          item.setAttribute("aria-pressed", String(item === trigger));
        });

        panels.forEach(panel => {
          panel.toggleAttribute(
            "hidden",
            panel.getAttribute("data-prompt-variant") !== variant
          );
        });
      });
    });
  });
</script>
