---
import Breadcrumb from "@/components/Breadcrumb.astro";

type StringTitle = { pageTitle: string };
type ArrayTitle = { pageTitle: [string, string]; titleTransition: string };

type Props = (StringTitle | ArrayTitle) & { pageDesc?: string };

const { props } = Astro;
---

<Breadcrumb />
<main id="main-content" class="app-layout pb-8">
  {
    "titleTransition" in props ? (
      <h1 class="text-3xl font-medium tracking-tight sm:text-4xl">
        {props.pageTitle[0]}
        <span transition:name={props.titleTransition}>
          {props.pageTitle[1]}
        </span>
      </h1>
    ) : (
      <h1 class="text-3xl font-medium tracking-tight sm:text-4xl">
        {props.pageTitle}
      </h1>
    )
  }
  <p class="mt-3 mb-10 font-mono text-[0.8125rem] text-foreground/60">
    {props.pageDesc}
  </p>
  <slot />
</main>
